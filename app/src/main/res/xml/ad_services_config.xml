<?xml version="1.0" encoding="utf-8"?>
<ad-services-config>
    <!-- Disable Topics API access to prevent AdServices binding errors on unsupported emulators -->
    <topics allowAllToAccess="false" />

    <!-- Disable Attribution Reporting (MEASUREMENT_SERVICE) to prevent onNullBinding on emulators -->
    <attribution allowAllToAccess="false" />
</ad-services-config>
